.env
__pycache__/
*.pyc
*.pyo
.venv/
venv/
dist/
*.egg-info/
.DS_Store
logs/

# Trained models. Regenerate with: python models/train.py
# The legacy bare pickles stay ignored. The registry artifacts (the estimators
# and the CURRENT pointer) are committed on purpose: the deploy builds from git,
# and without them the server silently falls back to the rule-based heuristic.
models/*.pkl

# Generated market data. Rebuild with:
#   python -m services.marketstore.backfill --from 2020-01-01
# Tens of megabytes of Parquet that git has no business storing.
data/market/
data/universe.parquet

# Point-in-time snapshots and the scored-news archive. These are accumulated
# observations that cannot be regenerated — they record what was knowable on
# the day they were written — so back them up rather than committing them.
data/pit/
