ANGELONE_API_KEY=your_api_key_here
ANGELONE_CLIENT_ID=your_client_id_here
ANGELONE_PASSWORD=your_pin_here
ANGELONE_TOTP_SECRET=your_totp_secret_here

# Required for /agent (ADK finance assistant). Optional for dashboard-only use.
OPENROUTER_API_KEY=your_openrouter_key_here
# Optional ADK overrides:
# ADK_LITELLM_MODEL=openrouter/openai/gpt-4o-mini
# ADK_AGENT_TEMPERATURE=0.4

# Postgres for users/schedules/logs (Step 2). Defaults assume local Postgres.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/myfinance

# Symmetric key for encrypting Angel password + TOTP secret in the users table.
# Generate one with:  python -m db.crypto generate
#
# Since /enroll stores credentials, this key is now load-bearing in both
# directions: lose it and every stored credential becomes unrecoverable and
# every user must re-enroll; leak it alongside a database dump and the attacker
# holds live trading credentials. Back it up, and rotate it only with a plan to
# re-encrypt. (The app password is hashed, not encrypted, so it is unaffected.)
ENCRYPTION_KEY=

# Signs the session cookie. Unset means a random key per process, which logs
# everyone out on every restart — set it so sessions survive a deploy.
# Required (32+ characters) in production; generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Marks a production deployment (Render is detected automatically via RENDER=true).
# In production the server refuses to start without SESSION_SECRET, ALLOWED_HOSTS,
# ENCRYPTION_KEY and an https PUBLIC_BASE_URL; the cookie is Secure and /docs is off.
APP_ENV=development

# Public URL of this server: the OAuth issuer, the /oauth/* endpoints and the
# MCP resource tokens are bound to (<this>/mcp/mcp) all come from it, so it must
# be the exact origin clients use (production: https://agentfolio.in, no www,
# no trailing slash). Must be https:// in production. Default http://localhost:8000.
PUBLIC_BASE_URL=http://localhost:8000

# OAuth redirect URIs a client may register, beyond the built-in claude.ai and
# claude.com connector callbacks. Comma-separated, matched exactly.
# OAUTH_EXTRA_REDIRECT_URIS=
# Loopback callbacks (http://localhost:<port>/..., for Claude Code, MCP Inspector)
# are allowed by default; set to 0 to refuse them.
# OAUTH_ALLOW_LOOPBACK_REDIRECTS=1

# How long the login cookie stays valid, in seconds. Default 604800 (7 days).
# This is the window in which a stolen cookie can rebuild a trading session
# without the app password, so shorten it if that matters more than convenience.
SESSION_COOKIE_MAX_AGE_SEC=604800

# Secure (HTTPS-only) session cookie. Defaults to on in production, off locally;
# 0 is refused in production.
SESSION_COOKIE_SECURE=0

# Enable the daily-briefing scheduler (polls DB every minute via main.py lifespan).
SCHEDULER_ENABLED=1

# Hostnames the app will answer to, comma-separated (TrustedHostMiddleware).
# Anything reading the Host header trusts the client until this is set, so set it
# to your real domain in production. Unset = accept any Host (local dev only).
ALLOWED_HOSTS=localhost,127.0.0.1
