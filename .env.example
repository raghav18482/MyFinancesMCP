ANGELONE_API_KEY=your_api_key_here
ANGELONE_CLIENT_ID=your_client_id_here
ANGELONE_PASSWORD=your_pin_here
ANGELONE_TOTP_SECRET=your_totp_secret_here

# Required for /agent (ADK finance assistant). Optional for dashboard-only use.
OPENROUTER_API_KEY=your_openrouter_key_here
# Optional ADK overrides:
# ADK_LITELLM_MODEL=openrouter/openai/gpt-4o-mini
# ADK_AGENT_TEMPERATURE=0.4

# Postgres for users/schedules/logs (Step 2). Defaults assume local Postgres.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/myfinance

# Symmetric key for encrypting Angel password + TOTP secret in the users table.
# Generate one with:  python -m db.crypto generate
ENCRYPTION_KEY=

# Enable the daily-briefing scheduler (polls DB every minute via main.py lifespan).
SCHEDULER_ENABLED=1
