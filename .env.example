ANGELONE_API_KEY=your_api_key_here
ANGELONE_CLIENT_ID=your_client_id_here
ANGELONE_PASSWORD=your_pin_here
ANGELONE_TOTP_SECRET=your_totp_secret_here

# Optional: LangGraph agent + RAG (see docs/langgraph-agent.md)
# Dashboard can send keys from the browser; server-side optional fallbacks:
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=   # or GEMINI_API_KEY= for Google AI (Gemini)
# TAVILY_API_KEY=
# SERPAPI_API_KEY=
# CHROMA_PATH=./data/chroma
# MEMORY_DB=./data/agent_memory.db
# ST_EMBEDDING_MODEL=all-MiniLM-L6-v2
# LANGGRAPH_RECURSION_LIMIT=25
